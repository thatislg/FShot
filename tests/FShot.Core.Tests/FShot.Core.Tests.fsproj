<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Geometry\TypesTests.fs" />
    <Compile Include="Domain\CaptureTests.fs" />
    <Compile Include="Domain\SelectionTests.fs" />
    <Compile Include="Domain\AnnotationTests.fs" />
    <Compile Include="Domain\HistoryTests.fs" />
    <Compile Include="Domain\ExportTests.fs" />
    <Compile Include="Domain\ConfigTests.fs" />
    <Compile Include="State\OverlayStateTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FShot.Core\FShot.Core.fsproj" />
  </ItemGroup>

</Project>
