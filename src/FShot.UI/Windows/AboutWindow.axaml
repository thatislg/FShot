<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FShot.UI.Windows.AboutWindow"
        Title="Thông tin &amp; Phím tắt"
        Width="420"
        Height="420"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24" Spacing="10">
        <TextBlock Text="F-Shot"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Phiên bản 0.1.0"
                   HorizontalAlignment="Center"
                   Foreground="Gray" />
        <TextBlock Text="Công cụ chụp màn hình Kawaii cho Windows."
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />

        <TextBlock Text="Phím tắt chính:"
                   FontWeight="Bold"
                   Margin="0,16,0,0" />

        <TextBlock Text="Enter / Click chuột trái&#x0a;· Xác nhận vùng chọn / xuất ảnh"
                   TextWrapping="Wrap" />
        <TextBlock Text="Esc / Click chuột phải&#x0a;· Hủy thao tác / đóng overlay"
                   TextWrapping="Wrap" />
        <TextBlock Text="Ctrl + S&#x0a;· Lưu ảnh vào file"
                   TextWrapping="Wrap" />
        <TextBlock Text="Ctrl + C&#x0a;· Sao chép ảnh vào clipboard"
                   TextWrapping="Wrap" />
        <TextBlock Text="Ctrl + Z / Ctrl + Y&#x0a;· Undo / Redo"
                   TextWrapping="Wrap" />
        <TextBlock Text="Tab / Shift + Tab&#x0a;· Chuyển công cụ tiếp theo / trước"
                   TextWrapping="Wrap" />

        <Button Content="Đóng"
                HorizontalAlignment="Center"
                Margin="0,12,0,0"
                Click="OnCloseClick" />
    </StackPanel>
</Window>
