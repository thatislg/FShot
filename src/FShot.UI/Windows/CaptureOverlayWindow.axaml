<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FShot.UI.SkiaCanvas"
        x:Class="FShot.UI.Windows.CaptureOverlayWindow"
        Title="F-Shot Capture"
        WindowDecorations="None"
        Topmost="True"
        CanResize="False"
        Background="#00000000"
        ShowInTaskbar="False"
        Focusable="True"
        IsVisible="False"
        IsHitTestVisible="True">
    <!--
        CaptureCanvas được bọc trong Canvas để có thể thêm Avalonia TextBox khi cần
        (ví dụ: tool Text). Canvas phải stretch toàn cửa sổ; CaptureCanvas sẽ được
        đặt kích thước bằng cửa sổ trong code-behind để đảm bảo hit-test và render
        vẫn phủ toàn màn hình.
    -->
    <Canvas x:Name="RootCanvas" Background="Transparent">
        <controls:CaptureCanvas x:Name="CaptureCanvas" IsHitTestVisible="True" />
    </Canvas>
</Window>
