<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FShot.UI.SkiaCanvas"
        x:Class="FShot.UI.Windows.CaptureOverlayWindow"
        Title="F-Shot Capture"
        WindowDecorations="None"
        Topmost="True"
        CanResize="False"
        Background="#66000000"
        ShowInTaskbar="False"
        Focusable="True"
        IsVisible="False"
        IsHitTestVisible="True">
    <controls:CaptureCanvas x:Name="CaptureCanvas" IsHitTestVisible="True" />
</Window>
