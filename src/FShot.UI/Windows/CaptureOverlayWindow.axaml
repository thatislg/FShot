<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FShot.UI.SkiaCanvas"
        x:Class="FShot.UI.Windows.CaptureOverlayWindow"
        Title="F-Shot Capture"
        SystemDecorations="None"
        Topmost="True"
        CanResize="False"
        Background="Transparent"
        ShowInTaskbar="False">
    <controls:CaptureCanvas x:Name="CaptureCanvas" />
</Window>
