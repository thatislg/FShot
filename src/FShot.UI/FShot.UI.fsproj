<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- P3.M02: khai báo RID + metadata cho đóng gói MSIX / dotnet publish. -->
    <RuntimeIdentifiers>win-x64;win-arm64;win-x86</RuntimeIdentifiers>
    <!-- Khi đóng gói từ FShot.Packaging (.wapproj), SetPublishProperties đổi MSBuildProjectExtensionsPath
         sang obj\wappublish\<rid>\ nhưng không tự chạy lại NuGet Restore cho F# project.
         Trỏ cố định ProjectAssetsFile về obj\project.assets.json nơi đã có sẵn toàn bộ RID. -->
    <ProjectAssetsFile Condition="!Exists('$(ProjectAssetsFile)') and Exists('$(MSBuildProjectDirectory)\obj\project.assets.json')">$(MSBuildProjectDirectory)\obj\project.assets.json</ProjectAssetsFile>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Logging\FShotLog.fs" />
    <Compile Include="Cli\CliArguments.fs" />
    <Compile Include="SkiaCanvas\ToolbarIcons.fs" />
    <Compile Include="SkiaCanvas\CaptureCanvasEvents.fs" />
    <Compile Include="Windows\PinWindow.axaml.fs" />
    <Compile Include="SkiaCanvas\CaptureCanvas.axaml.fs" />
    <Compile Include="Windows\NotificationWindow.axaml.fs" />
    <Compile Include="Windows\AboutWindow.axaml.fs" />
    <Compile Include="Windows\CaptureOverlayWindow.axaml.fs" />
    <Compile Include="Windows\FileNameEditor.axaml.fs" />
    <Compile Include="Windows\ColorSelector.axaml.fs" />
    <Compile Include="ConfigRuntime.fs" />
    <Compile Include="Windows\SettingsWindow.axaml.fs" />
    <Compile Include="Windows\LauncherWindow.axaml.fs" />
    <Compile Include="ViewModels\PlaceholderViewModel.fs" />
    <Compile Include="App.axaml.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Windows\NotificationWindow.axaml" />
    <EmbeddedResource Include="Windows\AboutWindow.axaml" />
    <EmbeddedResource Include="Windows\PinWindow.axaml" />
    <EmbeddedResource Include="Windows\CaptureOverlayWindow.axaml" />
    <EmbeddedResource Include="Windows\FileNameEditor.axaml" />
    <EmbeddedResource Include="Windows\ColorSelector.axaml" />
    <EmbeddedResource Include="Windows\SettingsWindow.axaml" />
    <EmbeddedResource Include="Windows\LauncherWindow.axaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Argu" Version="6.2.4" />
    <PackageReference Include="SkiaSharp" Version="4.152.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FShot.Core\FShot.Core.fsproj" />
    <ProjectReference Include="..\FShot.Rendering.Skia\FShot.Rendering.Skia.fsproj" />
    <ProjectReference Include="..\FShot.Platform.Win32\FShot.Platform.Win32.fsproj" />
  </ItemGroup>
</Project>
