<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RuntimeIdentifiers>win-x64;win-arm64;win-x86</RuntimeIdentifiers>
    <ProjectAssetsFile Condition="!Exists('$(ProjectAssetsFile)') and Exists('$(MSBuildProjectDirectory)\obj\project.assets.json')">$(MSBuildProjectDirectory)\obj\project.assets.json</ProjectAssetsFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Geometry\Types.fs" />
    <Compile Include="Geometry\Operations.fs" />
    <Compile Include="Geometry\AngleSnapping.fs" />
    <Compile Include="Geometry\PathSmoothing.fs" />
    <Compile Include="Domain\Capture.fs" />
    <Compile Include="Domain\Selection.fs" />
    <Compile Include="Domain\Annotation.fs" />
    <Compile Include="Domain\History.fs" />
    <Compile Include="Domain\HitTesting.fs" />
    <Compile Include="Domain\Export.fs" />
    <Compile Include="Domain\Config.fs" />
    <Compile Include="State\OverlayState.fs" />
  </ItemGroup>

</Project>
